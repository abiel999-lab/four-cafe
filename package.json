{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",

        "serve": "php artisan serve --port=8001",

        "start": "concurrently -k -n VITE,LARAVEL -c blue,green \"npm run dev\" \"npm run serve\"",

        "start:build": "concurrently -k -n BUILD,LARAVEL -c magenta,green \"npm run build\" \"npm run serve\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    }
}
